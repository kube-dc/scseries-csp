# Copy to .env or .env/storage.env (chmod 600). Read by hack/ tools; never committed.
# Array REST endpoint (Storage Center or DSM Data Collector) and an Admin account for the hack/ tools.
SC_HOST=sc.example.com
SC_PORT=3033
SC_USER=Admin
SC_PASSWORD=
# Dedicated CSP account (hack/sc-maint.py csp-user writes these to .env/csp.env)
# CSP_SC_USER=scseries-csp
# CSP_SC_PASSWORD=
# Pinned SHA-256 of the array REST certificate:
#   openssl s_client -connect $SC_HOST:3033 </dev/null | openssl x509 -noout -fingerprint -sha256
# SC_TLS_FINGERPRINT=
